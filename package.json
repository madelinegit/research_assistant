    "expo-sharing": "~57.0.14",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "express": "^5.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
